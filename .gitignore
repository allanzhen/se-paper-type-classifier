# Data — keep folder structure (.gitkeep) but ignore large API dumps.
# Raw and interim data are regenerable from the pipeline;
# gold/ and processed/ are tracked because they are study outputs.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Logs
logs/
*.log
