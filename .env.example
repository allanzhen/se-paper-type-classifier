# Optional but strongly recommended — raises Semantic Scholar's limit
# from ~1 req/sec to 100 req/sec. Request a key at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional — controls where HuggingFace caches downloaded models.
# Leave empty to use the default (~/.cache/huggingface).
HF_HOME=
